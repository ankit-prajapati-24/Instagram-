# Copy to .env and edit. Every value here is optional; these are the defaults.

# --- OmniRoute gateway ---------------------------------------------------
OMNIROUTE_BASE=http://localhost:20128/v1
OMNIROUTE_KEY=omniroute

# Leave blank to let the gateway route with auto/* aliases. Pin a model here
# once you know which provider you actually want.
RAHASYA_MODEL_STRONG=
RAHASYA_MODEL_CHEAP=
RAHASYA_MODEL_IMAGE=
RAHASYA_MODEL_EMBED=

# NOTE: provider API keys do NOT go here. They go in OmniRoute's own env file
# at ~/.omniroute/.env, or through its dashboard. See docs/omniroute-setup.md

# --- Voice (local edge-tts) ---------------------------------------------
# hi-IN-MadhurNeural (male) or hi-IN-SwaraNeural (female). Both are tagged
# "Friendly, Positive", so the offsets below pull them darker.
RAHASYA_VOICE=hi-IN-MadhurNeural
RAHASYA_VOICE_RATE=-8%
RAHASYA_VOICE_PITCH=-6Hz

# --- Captions ------------------------------------------------------------
# caption_text = Roman Hinglish (default), voice_text = Devanagari
RAHASYA_CAPTIONS=caption_text
RAHASYA_FONT=Arial
RAHASYA_FONT_DEVA=Nirmala UI

# --- Paths ---------------------------------------------------------------
# RAHASYA_FFMPEG=            # defaults to the imageio-ffmpeg binary
# RAHASYA_WORK=./work
# RAHASYA_OUT=./outputs
# RAHASYA_DB=./engine.db

# --- Guardrail -----------------------------------------------------------
# Pipeline pauses when the day's spend crosses this.
RAHASYA_DAILY_USD=2.0
